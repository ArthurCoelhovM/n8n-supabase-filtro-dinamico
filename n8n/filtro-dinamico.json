        0,
        0
      ],
      "webhookId": "27c796c6-6964-444f-b4e2-2a8aa1dda731"
    },
    {
      "parameters": {},
      "id": "c8105f8d-a436-41bd-9c50-519f7dd55cb8",
      "name": "Teste manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "config_filtro",
        "returnAll": true
      },
      "id": "16c827e4-38c6-43ac-a907-44d1caa61583",
      "name": "Buscar configs",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        240,
        100
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const consulta = $('Webhook').isExecuted ? ($('Webhook').first().json.query || {}) : {};\nconst configs = $input.all().map(item => item.json).filter(c => c.id);\n\nif (consulta.campo) {\n  return [{\n    json: {\n      campo: consulta.campo,\n      operador: consulta.operador || 'igual',\n      valor: consulta.valor ?? '',\n      origem: 'url'\n    }\n  }];\n}\n\nlet config;\nif (consulta.config) {\n  config = configs.find(c => c.nome === consulta.config);\n  if (!config) {\n    return [{ json: { erro: `Config \"${consulta.config}\" não encontrada`, configsDisponiveis: configs.map(c => c.nome) } }];\n  }\n} else {\n  config = configs.find(c => c.ativo);\n  if (!config) {\n    return [{ json: { erro: 'Nenhuma config ativa em config_filtro' } }];\n  }\n}\n\nreturn [{\n  json: {\n    campo: config.campo,\n    operador: config.operador,\n    valor: config.valor,\n    origem: 'config',\n    config: config.nome\n  }\n}];\n"
      },
      "id": "9968d8a0-44c8-401c-adc2-05a0cb3bda4f",
      "name": "Montar filtro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "clientes",
        "returnAll": true
      },
      "id": "3eaa6a96-e96b-4ddf-9560-1321d08ee204",
      "name": "Buscar clientes",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        720,
        100
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const filtro = $('Montar filtro').first().json;\nif (filtro.erro) {\n  return [{ json: filtro }];\n}\n\nconst registros = $input.all().map(item => item.json).filter(r => r.id !== undefined);\nconst operadores = ['igual', 'diferente', 'contem', 'maior', 'menor'];\nconst campos = registros.length ? Object.keys(registros[0]) : [];\n\nif (!operadores.includes(filtro.operador)) {\n  return [{ json: { erro: `Operador inválido: ${filtro.operador}`, operadoresAceitos: operadores } }];\n}\nif (!campos.includes(filtro.campo)) {\n  return [{ json: { erro: `Campo inexistente: ${filtro.campo}`, camposDisponiveis: campos } }];\n}\n\nfunction normalizar(texto) {\n  return String(texto ?? '')\n    .normalize('NFD')\n    .replace(/[̀-ͯ]/g, '')\n    .toLowerCase()\n    .trim();\n}\n\nfunction comparar(valorRegistro, operador, valor) {\n  if (operador === 'maior' || operador === 'menor') {\n    const a = Number(valorRegistro);\n    const b = Number(valor);\n    if (Number.isNaN(a) || Number.isNaN(b)) return false;\n    return operador === 'maior' ? a > b : a < b;\n  }\n  const a = normalizar(valorRegistro);\n  const b = normalizar(valor);\n  if (operador === 'igual') return a === b;\n  if (operador === 'diferente') return a !== b;\n  return a.includes(b);\n}\n\nconst resultado = registros.filter(r => comparar(r[filtro.campo], filtro.operador, filtro.valor));\n\nreturn [{\n  json: {\n    filtro,\n    total: resultado.length,\n    registros: resultado,\n    geradoEm: new Date().toISOString()\n  }\n}];\n"
      },
